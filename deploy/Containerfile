# paperless-llm application image (backend + built frontend).
# Build from the repository root:
#   podman build -f deploy/Containerfile -t paperless-llm .

# --- frontend build stage ---------------------------------------------
FROM docker.io/library/node:24-alpine AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# --- backend runtime --------------------------------------------------
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim
WORKDIR /app/backend

# tesseract (with osd traineddata): orientation detection so flipped
# scans are rotated upright before the vision model sees them. The app
# degrades gracefully without it — but the image ships it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-osd \
    && rm -rf /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# Dependency layer (cached until pyproject/lock change).
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev

# Application code + the corpus the seeder uploads.
COPY backend/app ./app
COPY backend/alembic.ini ./alembic.ini
COPY backend/alembic ./alembic
COPY backend/tests/fixtures/corpus ./tests/fixtures/corpus
RUN uv sync --frozen --no-dev

# Built frontend where app.main expects it (../frontend/dist).
COPY --from=frontend /build/dist /app/frontend/dist

# Run as a dedicated non-root user; /data is the single writable state
# directory (DB + OCR cache) — mount a volume there.
RUN useradd -r -u 1000 app && mkdir /data && chown app:app /data
USER app

ENV PATH="/app/backend/.venv/bin:$PATH" \
    PLLM_DATABASE_URL="sqlite+aiosqlite:////data/paperless_llm.sqlite3" \
    PLLM_DATA_DIR="/data"

LABEL org.opencontainers.image.title="paperless-llm" \
      org.opencontainers.image.description="Local-LLM metadata assistant for paperless-ngx" \
      org.opencontainers.image.source="https://github.com/Luminger/paperless-llm" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"

EXPOSE 8100
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
  CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8100/api/health', timeout=3).status==200 else 1)"]
CMD ["paperless-llm", "serve", "--host", "0.0.0.0", "--port", "8100"]
