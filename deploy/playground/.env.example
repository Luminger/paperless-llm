# LLM endpoint the app container talks to. Must be reachable FROM the
# container network — a host-loopback-bound server (127.0.0.1) is NOT;
# use a LAN-visible route (reverse proxy) or bind your server to 0.0.0.0.
PLLM_AGENT_BASE_URL=http://127.0.0.1:8001/v1
PLLM_AGENT_MODEL=qwen3.6-27b
PLLM_AGENT_MAX_CONCURRENT=2

# Optional: local embeddings endpoint for the entity index (TEI etc.).
#PLLM_EMBEDDINGS_BASE_URL=
#PLLM_EMBEDDINGS_MODEL=
#PLLM_RERANKER_BASE_URL=
#PLLM_RERANKER_MODEL=
# Optional: enables POST /api/webhooks/paperless with this shared secret.
#PLLM_WEBHOOK_SECRET=
