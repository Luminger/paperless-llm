# paperless-llm playground configuration.
#   cp .env.example .env   # then edit; compose.yaml interpolates these.
# Paperless runs in the stack with throwaway credentials — you only
# point at your LLM endpoint(s). All values are optional (defaults in
# compose.yaml), but you almost certainly want your own agent endpoint.

# --- local LLM endpoints (OpenAI-compatible) --------------------------
# The app is host-networked, so 127.0.0.1 here means the podman host.
PLLM_AGENT_BASE_URL=http://127.0.0.1:8001/v1
PLLM_AGENT_MODEL=qwen3.6-27b
#PLLM_AGENT_MAX_CONCURRENT=2
#PLLM_LLM__AGENT__SUPPORTS_STREAMING=false

# Optional embeddings / reranker endpoints (entity index, duplicates).
#PLLM_EMBEDDINGS_BASE_URL=
#PLLM_EMBEDDINGS_MODEL=
#PLLM_RERANKER_BASE_URL=
#PLLM_RERANKER_MODEL=

# --- webhook ingress --------------------------------------------------
# Shared secret for POST /api/webhooks/paperless (empty disables it).
#PLLM_WEBHOOK_SECRET=
# URL the paperless container reaches the (host-networked) app under.
#PLLM_WEBHOOK_PUBLIC_URL=http://host.containers.internal:8100

# --- paperless deep links ---------------------------------------------
# URL users reach the playground paperless under (LAN-reachable).
#PLLM_PAPERLESS_EXTERNAL_URL=
