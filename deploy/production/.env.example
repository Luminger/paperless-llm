# paperless-llm production configuration.
#   cp .env.example .env   # then edit; compose.yaml interpolates these.
# Only the first three are required.

# --- paperless --------------------------------------------------------
# URL of your paperless-ngx, reachable FROM INSIDE the container
# (127.0.0.1 is the container itself — use a LAN name/address).
PLLM_PAPERLESS_BASE_URL=http://paperless.example:8000
# API token (paperless → Settings → My profile). Optional: without it
# every user signs in with their own paperless credentials.
PLLM_PAPERLESS_TOKEN=
# URL your browser reaches paperless under (UI deep links); defaults
# to the base URL.
PLLM_PAPERLESS_EXTERNAL_URL=

# --- local LLM endpoints (OpenAI-compatible) --------------------------
PLLM_AGENT_BASE_URL=http://llm.example:8001/v1
PLLM_AGENT_MODEL=qwen3.6-27b
#PLLM_AGENT_MAX_CONCURRENT=2
#PLLM_AGENT_SUPPORTS_STREAMING=true

# Vision/OCR profile; falls back to the agent endpoint when unset.
#PLLM_OCR_BASE_URL=
#PLLM_OCR_MODEL=

# Optional embeddings / reranker endpoints (entity index, duplicates).
#PLLM_EMBEDDINGS_BASE_URL=
#PLLM_EMBEDDINGS_MODEL=
#PLLM_RERANKER_BASE_URL=
#PLLM_RERANKER_MODEL=

# --- webhook ingress --------------------------------------------------
# Shared secret for POST /api/webhooks/paperless (empty disables it).
#PLLM_WEBHOOK_SECRET=
# URL this app is reachable at FROM PAPERLESS (workflow webhook target).
#PLLM_WEBHOOK_PUBLIC_URL=

# --- app --------------------------------------------------------------
# Host port the UI/API is published on.
#PLLM_PORT=8100
