# paperless-llm production configuration. Copy to .env and edit.
# Everything the container reaches must be visible FROM the container
# network — 127.0.0.1 means the container itself, not your host.

# --- paperless-ngx -----------------------------------------------------
PLLM_PAPERLESS_BASE_URL=http://paperless.example.lan:8000
# API token for the app's background work (Settings > My profile in
# paperless). With auth mode "paperless", logged-in users act under
# their OWN token; this one covers webhooks and bulk jobs.
PLLM_PAPERLESS_TOKEN=
# Where YOUR BROWSER reaches paperless (UI deep links), if different:
#PLLM_PAPERLESS_EXTERNAL_URL=https://paperless.example.com

# --- local LLM (OpenAI-compatible: vLLM, llama.cpp, LM Studio, ...) ----
PLLM_AGENT_BASE_URL=http://llm.example.lan:8001/v1
PLLM_AGENT_MODEL=qwen3.6-27b
PLLM_AGENT_MAX_CONCURRENT=2
PLLM_AGENT_SUPPORTS_STREAMING=true
# Separate vision model for OCR (falls back to the agent endpoint):
#PLLM_OCR_BASE_URL=
#PLLM_OCR_MODEL=

# Optional embeddings endpoint (semantic duplicate detection):
#PLLM_EMBEDDINGS_BASE_URL=
#PLLM_EMBEDDINGS_MODEL=

# --- access ------------------------------------------------------------
# none: trusted network / VPN. proxy: trust the Remote-User header from
# your authenticating reverse proxy. paperless: login with paperless
# accounts.
PLLM_AUTH_MODE=none
# Shared secret for paperless post-consume webhook ingestion:
#PLLM_WEBHOOK_SECRET=

# Host port the app is published on:
PLLM_PORT=8100
