# paperless-llm production configuration.
#   cp .env.example .env   # then edit; compose.yaml interpolates these.
# Only the first three are required.
#
# OPTIONAL settings (paperless token, OCR/embeddings/reranker
# endpoints, webhook secret/public URL, agent tuning) moved to
# optional.env: uncomment them there. Reason: a variable defaulted to
# "" in compose.yaml still reaches the container as SET, which locks
# that key read-only in the Settings UI — commented lines in
# optional.env create no variable at all.

# --- paperless --------------------------------------------------------
# URL of your paperless-ngx, reachable FROM INSIDE the container
# (127.0.0.1 is the container itself — use a LAN name/address).
PLLM_PAPERLESS_BASE_URL=http://paperless.example:8000

# --- agent LLM endpoint (OpenAI-compatible) ---------------------------
PLLM_AGENT_BASE_URL=http://llm.example:8001/v1
PLLM_AGENT_MODEL=qwen3.6-27b

# --- app --------------------------------------------------------------
# Host port the UI/API is published on. compose.yaml binds it to
# 127.0.0.1 (loopback) — put your reverse proxy in front; edit the
# ports: mapping there to 0.0.0.0 deliberately for direct LAN use.
#PLLM_PORT=8100

# Session cookie Secure flag — on by default: behind TLS (reverse
# proxy) it must be on. Set false ONLY for plain-HTTP LAN setups,
# otherwise logins over plain HTTP won't stick.
#PLLM_COOKIE_SECURE=true
