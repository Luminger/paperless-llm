# paperless-llm — OPTIONAL container environment (loaded via env_file
# in compose.yaml; keep this file next to it).
#
# Uncomment a line to set it. A commented line creates NO variable in
# the container — that matters: environment-provided keys are locked
# (read-only) in the Settings UI, and a ${VAR:-} default in
# compose.yaml would export an empty string even when unset. Anything
# you leave commented here stays editable at runtime under Settings.
#
# Names here are the app's real variables (PLLM_ prefix, __ nesting) —
# values are taken literally, no ${...} interpolation.

# --- paperless --------------------------------------------------------
# API token (paperless -> Settings -> My profile). Without it every
# user signs in with their own paperless credentials.
#PLLM_PAPERLESS__TOKEN=

# URL your browser reaches paperless under (UI deep links); defaults
# to the base URL.
#PLLM_PAPERLESS__EXTERNAL_URL=

# --- agent LLM tuning -------------------------------------------------
#PLLM_LLM__AGENT__MAX_CONCURRENT=2
#PLLM_LLM__AGENT__SUPPORTS_STREAMING=true

# --- vision/OCR profile (falls back to the agent endpoint when unset)
#PLLM_LLM__OCR__BASE_URL=
#PLLM_LLM__OCR__MODEL=

# --- optional embeddings / reranker (entity index, duplicate finder)
#PLLM_LLM__EMBEDDINGS__BASE_URL=
#PLLM_LLM__EMBEDDINGS__MODEL=
#PLLM_LLM__RERANKER__BASE_URL=
#PLLM_LLM__RERANKER__MODEL=

# --- webhook ingress --------------------------------------------------
# Shared secret for POST /api/webhooks/paperless (unset disables the
# endpoint; the one-click setup in Settings -> Paperless generates one
# — leave this commented to let it manage the secret).
#PLLM_WEBHOOK__SECRET=

# URL THIS app is reachable at FROM PAPERLESS — what the workflow
# webhook posts to. Required for the one-click workflow setup.
#PLLM_WEBHOOK__PUBLIC_URL=
